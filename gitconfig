[user]
	name = Kirill Mokevnin
	email = mokevnin@gmail.com
	signingkey = ssh-rsa 

[init]
	defaultBranch = main

# подпись коммитов ssh-ключом через агент 1Password (каска brew-cask:1password)
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign

# требует git-lfs (brew:git-lfs)
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# gh идёт из mise, поэтому без абсолютного пути
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[includeIf "gitdir:~/hexlet-exercise-kit/**"]
	path = ~/hexlet-exercise-kit/.githooks/gitconfig
