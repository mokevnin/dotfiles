[user]
	name = Kirill Mokevnin
	email = mokevnin@gmail.com
	signingkey = ~/.ssh/id_home

[init]
	defaultBranch = main

# commits signed with the ssh key copied out of 1Password to ~/.ssh/id_home,
# so signing works while 1Password is locked
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

# requires git-lfs (brew:git-lfs)
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# gh comes from mise, hence no absolute path
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials
